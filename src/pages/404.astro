---
import Arrow from "@/components/site/Arrow.astro";
import Fx from "@/components/site/Fx.astro";
import Base from "@/layouts/Base.astro";

export const prerender = true;

const columns = Array.from({ length: 12 }, (_, index) => index);
---

<Base
  title="ページが見つかりません"
  description="URLが変わったか、ページが削除されました。"
  noindex
>
  <section class="nf" aria-labelledby="h-nf">
    <div class="nf__grid" aria-hidden="true">
      {columns.map(index => <i style={`--k:${index}`} />)}
    </div>
    <div class="nf__in">
      <p class="nf__lab mono">
        <span class="dot" aria-hidden="true"></span>
        404 / Not Found
      </p>
      <p class="nf__ciao">
        <Fx
          text="Ciao"
          mode="goodbye"
          en
          hover
          lang="it"
          class="fx--display"
        />
      </p>
      <div class="nf__row">
        <h1 class="nf__ttl t-d3" id="h-nf">
          <span class="ph">このページは</span><span class="ph"
            >もうありません</span
          >
        </h1>
        <div class="nf__side">
          <p class="nf__body t-lead">
            <span class="ph">URLが変わったか、</span><span class="ph"
              >ページが削除されました。</span
            >
          </p>
          <ul class="nf__act">
            <li>
              <a class="btn btn--lg" href="/">
                トップへ
                <Arrow />
              </a>
            </li>
            <li>
              <a class="link" href="/projects">
                <span class="dot" aria-hidden="true"></span>
                実績の一覧へ
              </a>
            </li>
            <li>
              <a class="link" href="/contact">
                <span class="dot" aria-hidden="true"></span>
                お問い合わせ
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    min-height: calc(100svh - var(--hd));
    padding: clamp(28px, 2.8vw, 40px) var(--m) clamp(36px, 3vw, 44px);
    display: flex;
    overflow: clip;
  }

  .nf__grid {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--m) - var(--g) / 2);
    right: calc(var(--m) - var(--g) / 2);
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    pointer-events: none;
  }

  .nf__grid i {
    border-left: 1px solid var(--rule-2);
    transform-origin: 50% 0;
  }

  .nf__grid i:last-child {
    border-right: 1px solid var(--rule-2);
  }

  :global(html.js:not(.rm)) .nf__grid i {
    transform: scaleY(0);
  }

  :global(html.js.is-go:not(.rm)) .nf__grid i {
    transform: none;
    transition: transform 1.2s var(--ease) calc(var(--k) * 40ms);
  }

  /* Ciao の大きさを、この箱の幅（cqi）から決める */
  .nf__in {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .nf__lab {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
  }

  /* 塗りが上へ抜けて、線だけが残る。線の色は、ロゴの字形と同じティール（Fx に付けた .fx--display）。
     Ciao の線の幅は 1em あたり 2.04em（Inter Bold、字間 -0.04em）。箱の幅の 48.9% の字の大きさで、
     左右の端がちょうど本文の幅になる。背の低い画面では、最初の画面に見出しとボタンまで収まる大きさに抑える
     （348px は、ヘッダー・ラベル・見出しの行・余白の合計。0.84 は行の高さ） */
  .nf__ciao {
    margin-top: clamp(16px, 1.4vw, 20px);
    margin-left: -0.025em;
    font-weight: var(--fw-bold);
    /* 型の外: 画面の幅いっぱいに置く Ciao（コンテナの単位が使えないブラウザ向け） */
    font-size: min(calc((100vw - var(--m) * 2) * 0.489), 62svh);
    /* 型の外: 画面の幅いっぱいに置く Ciao */
    font-size: min(48.9cqi, max(24cqi, (100svh - 348px) / 0.84));
    line-height: 0.84;
    letter-spacing: -0.04em;
    white-space: nowrap;
    --st: 110ms;
    --dur: 1.1s;
  }

  /* 線の太さも、ロゴの字形（CIAO、O の図）と同じ 1.5px にそろえる */
  .nf__ciao :global(.fx) {
    --stroke: 1.5px;
  }

  .nf__row {
    margin-top: auto;
    padding-top: clamp(24px, 2.8vw, 40px);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--g);
    align-items: end;
  }

  .nf__ttl {
    grid-column: 1 / span 7;
  }

  .nf__ttl .ph,
  .nf__body .ph {
    display: inline-block;
  }

  .nf__side {
    grid-column: 8 / -1;
  }

  .nf__act {
    margin-top: 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 28px;
  }

  /* 右の列が狭い幅では、3 つの案内が 1 行に入らない。ボタンを 1 行に、リンクをその下に並べる */
  @media (max-width: 1199px) {
    .nf__act li:first-child {
      flex-basis: 100%;
    }
  }

  @media (max-width: 1023px) {
    .nf__ttl,
    .nf__side {
      grid-column: 1 / -1;
    }

    .nf__side {
      margin-top: 20px;
    }
  }

  @media (max-width: 767px) {
    .nf {
      min-height: 0;
      padding-bottom: 72px;
    }

    /* 狭い画面は縦に流すので、幅だけで決める */
    .nf__ciao {
      /* 型の外: 画面の幅いっぱいに置く Ciao */
      font-size: 48.9cqi;
    }

    .nf__row {
      margin-top: 0;
      padding-top: 40px;
    }

    .nf__grid i:nth-child(n + 5) {
      display: none;
    }

    .nf__grid i:nth-child(4) {
      border-right: 1px solid var(--rule-2);
    }
  }
</style>
