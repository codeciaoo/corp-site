---
import PositionDetail from "@/components/careers/PositionDetail.astro";
import { positionOf } from "@/data/careers";
import Base from "@/layouts/Base.astro";

export const prerender = true;

const position = positionOf("fullstack");
---

<Base title={`${position.title}の募集`} description={position.lead}>
  <PositionDetail position={position} />
</Base>
