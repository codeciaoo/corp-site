---
import Approach from "@/components/home/Approach.astro";
import Engage from "@/components/home/Engage.astro";
import Hero from "@/components/home/Hero.astro";
import Services from "@/components/home/Services.astro";
import Statement from "@/components/home/Statement.astro";
import Work from "@/components/home/Work.astro";
import Cta from "@/components/site/Cta.astro";
import Base from "@/layouts/Base.astro";
import { getPublishedProjects } from "@/lib/projects";

export const prerender = true;

// 実績の一覧（/projects）と同じ順番と番号で、公開する実績を出す（5 件まで）
const projects = (await getPublishedProjects()).slice(0, 5);
---

<Base>
  <Hero />
  <Statement />
  <Services />
  <Approach />
  <Work projects={projects} />
  <Engage />
  <Cta size="mega" />
</Base>
