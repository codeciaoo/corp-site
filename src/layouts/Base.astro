---
import Footer from "@/components/site/Footer.astro";
import GlyphDefs from "@/components/site/GlyphDefs.astro";
import Header from "@/components/site/Header.astro";
import { COMPANY, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from "@/data/site";
import restFontsUrl from "@/styles/fonts.rest.generated.css?url";
import "@/styles/site.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** ヘッダーとフッターを出さない（単体で渡す資料用のページ） */
  bare?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = "/og.png",
  noindex = false,
  bare = false,
} = Astro.props;

const { pathname } = Astro.url;
const pageTitle = title
  ? `${title} | ${SITE_NAME}`
  : `${SITE_NAME} | こんにちは 新しい仕組み`;
const canonical = new URL(pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: COMPANY.name,
  alternateName: SITE_NAME,
  url: SITE_URL,
  logo: new URL("/icon.png", SITE_URL).href,
  description: SITE_DESCRIPTION,
  foundingDate: "2024-02-19",
  address: {
    "@type": "PostalAddress",
    postalCode: "141-0021",
    addressRegion: "東京都",
    addressLocality: "品川区",
    streetAddress: "上大崎 3-14-34 プラスワン 402",
    addressCountry: "JP",
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* 最初の画面に出ない字のフォントは、最初の描画のあとで読み込む。
         全部のフォントを同時に読むと、遅い回線で帯域を取り合い、最初の画面の字が出るのが遅れる。
         CSS は media="print" で先に取っておき、最初の描画（first-contentful-paint）を確かめてから全体に効かせる。
         描画の通知が使えないブラウザでは load のあと、どちらも来なければ 3 秒後に効かせる。
         JS が動かないときは普通に読む */}
    <link rel="stylesheet" href={restFontsUrl} media="print" id="rest-fonts" />
    <noscript><link rel="stylesheet" href={restFontsUrl} /></noscript>
    <script is:inline>
      (function () {
        var link = document.getElementById("rest-fonts");
        var done = false;
        var apply = function () {
          if (done) return;
          done = true;
          link.media = "all";
        };
        var types = (window.PerformanceObserver && PerformanceObserver.supportedEntryTypes) || [];
        if (types.indexOf("paint") !== -1) {
          new PerformanceObserver(function (list) {
            if (list.getEntriesByName("first-contentful-paint").length) apply();
          }).observe({ type: "paint", buffered: true });
        } else {
          addEventListener("load", apply);
        }
        setTimeout(apply, 3000);
      })();
    </script>

    <script is:inline>
      document.documentElement.classList.add("js");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches)
        document.documentElement.classList.add("rm");
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <GlyphDefs />
    {!bare && <Header pathname={pathname} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import "@/scripts/site";
    </script>
  </body>
</html>
