---
// 03 / 代表メッセージ。
// 代表の経験から始める。会社の説明、Ciaoの意味、置き換えてきたやり方の例は、トップページとこのページの 01 に
// 置いてあるので、ここでは繰り返さない。
// 写真は 12 列の 4〜7 列目（縦横比 4:5）。本文のほうが長いので、写真は本文に追従する。
import Portrait from "@/components/members/Portrait.astro";
import SectionHead from "@/components/site/SectionHead.astro";
import { MEMBERS } from "@/data/members";

const president = MEMBERS[0];
---

<section class="sec grid" id="message" aria-labelledby="h-message">
  <SectionHead no="03" en="Message" title="代表メッセージ" id="h-message" />
  <div class="body">
    <div class="msg__photo">
      <Portrait photo={president.photo} alt="代表取締役社長 田原 翼" />
    </div>
    <div class="msg__tx">
      <p class="msg__hello t-h2">
        <span class="msg__en">CodeCiao</span>の田原です
      </p>
      <p>
        私はコンサルタントとエンジニアの両方の立場で、10年以上この仕事を続けてきました。目立つ技術よりも、シンプルで長く使えるものを選びます。
      </p>
      <p>
        長いあいだ現場を支えてきたやり方をきちんと終わらせるところまでを、私たちは仕事にしています。
      </p>
      <p>
        いまは開発の多くをAIエージェントが担当しています。コードを速く書けるようになった分、「本当に動くのか」を確かめる責任は重くなりました。CodeCiaoでは、AIが書いたコードを別のAIと自動のチェックが検証し、最後に人が判断します。「動いた」という報告は、担当者が自分で確かめてからします。私たちはこの当たり前の手順を、仕組みとして守っています。
      </p>
      <p class="msg__sign">
        <span class="msg__role t-caption">代表取締役社長</span>
        <span class="msg__name t-h3">田原 翼</span>
      </p>
    </div>
  </div>
</section>

<style>
  .body {
    grid-column: 4 / -1;
    min-width: 0;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
  }

  /* 12 列の 4〜7 列目。本文を読んでいる間、写真はヘッダーの下に留まる
     （留まる位置は、左の列の SectionHead と同じ高さ） */
  .msg__photo {
    grid-column: 1 / span 4;
    position: sticky;
    top: calc(var(--hd) + 36px);
  }

  /* 本文は 12 列の 8 列目から */
  .msg__tx {
    grid-column: 5 / -1;
    max-width: 36em;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }

  .msg__tx > p + p {
    margin-top: 1.5em;
  }

  /* WebKit は、行頭にある欧文の span の前にもアキを入れ、左端が写真と本文より 3px 内側にずれた。
     箱（inline-block）にすると、行頭のアキは付かない。代わりに和文との境目のアキも自動では付かないので、
     どのブラウザでも同じ幅（0.14em）を margin で付ける */
  .msg__en {
    display: inline-block;
    margin-right: 0.14em;
  }

  /* 段落の間隔（上の指定）より強くするため、親から書く */
  .msg__tx > .msg__hello + p {
    margin-top: clamp(24px, 2.6vw, 36px);
  }

  .msg__tx > p + .msg__sign {
    margin-top: clamp(36px, 4vw, 56px);
  }

  .msg__sign {
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 18px;
  }

  .msg__role {
    color: var(--ink-2);
  }

  /* 姓と名の間で折り返さない */
  .msg__name {
    white-space: nowrap;
  }

  /* 899px 以下: 節の見出しが上に来る。写真は 1〜3 列目、本文は 4 列目から */
  @media (max-width: 899px) {
    .body {
      grid-column: 1 / -1;
    }

    .msg__photo {
      grid-column: 1 / span 3;
    }

    .msg__tx {
      grid-column: 4 / -1;
      font-size: var(--fs-body);
      line-height: var(--lh-body);
    }
  }

  /* 767px 以下（4 列）: 写真は 1 列目、本文は 2 列目から */
  @media (max-width: 767px) {
    .msg__photo {
      grid-column: 1;
    }

    .msg__tx {
      grid-column: 2 / -1;
    }
  }

  /* 599px 以下: 写真は幅いっぱい（メンバーのページと同じ大きさ）。本文はその下 */
  @media (max-width: 599px) {
    .msg__photo {
      grid-column: 1 / -1;
      position: static;
    }

    .msg__tx {
      grid-column: 1 / -1;
      margin-top: 32px;
    }
  }
</style>
