---
// 02 / Vision と、大事にしていること。
// ビジョンの 1 文を、12 列を使って 2 つの大きい語で組む。
// 「作って終わり」は役目を終えるもの（これまで）なので、塗りが上へ抜けて線が残る（さよなら）。
// 「使い続けて価値が出る」はこれから届けるものなので、線に下から塗りが満ちる（こんにちは）。
// つなぎの「ではなく」「プロダクトを届ける」は、12 列の 8 列目に小さく置く。
// 読み上げでは、元の 1 文（かぎ括弧つき）をそのまま読む。見た目では、かぎ括弧の代わりに線と塗りで語を区切る。
// 767px 以下: 大きい語は --fs-verb（48px 以上）で、句ごとに改行して幅いっぱいに置く。
import Fx from "@/components/site/Fx.astro";
import NumberedRows from "@/components/site/NumberedRows.astro";
import SectionHead from "@/components/site/SectionHead.astro";

interface Value {
  title: string;
  body: string;
}

const VALUES: Value[] = [
  {
    title: "確かめてから言う",
    body: "CodeCiaoは、テスト・ログ・差分で動作を証明できるまで「完了」と言いません。「動いた」という報告は、担当者が自分で確かめてからします。",
  },
  {
    title: "足すより削る",
    body: "機能を足す前に、その機能が本当に必要かを確かめます。シンプルなシステムのほうが長く使えるからです。",
  },
  {
    title: "根本を直す",
    body: "その場だけの対処はしません。原因を突き止めて、同じ失敗が起きない仕組みに変えます。",
  },
  {
    title: "伝わるまで|説明する",
    body: "つくったものは、設計書・手順書・解説動画と一緒に渡します。ほかの人が同じ作業を続けられるようにするためです。",
  },
];
---

<section
  class="sec sec--ink grid vsn"
  id="vision"
  aria-labelledby="h-purpose"
>
  <SectionHead no="02" en="Vision" title="目指すこと" id="h-purpose" />

  <p class="vs">
    <span class="sr"
      >「作って終わり」ではなく「使い続けて価値が出る」プロダクトを届ける</span
    >
    <span class="vs__in" aria-hidden="true">
      <span class="vs__big vs__a"
        ><Fx text="作って|終わり" mode="goodbye" delay={200} /></span
      >
      <span class="vs__sm vs__c1">ではなく</span>
      <span class="vs__big vs__b"
        ><Fx text="使い続けて|価値が出る" delay={900} /></span
      >
      <span class="vs__sm vs__c2">プロダクトを届ける</span>
    </span>
  </p>

  <div class="vl__side">
    <p class="vl__en mono">Values</p>
    <h3 class="vl__head" id="h-values">大事にしていること</h3>
  </div>
  <div class="vl__body">
    <NumberedRows items={VALUES} label="大事にしていること" level="h4" />
  </div>
</section>

<style>
  /* 見出しの下に、12 列いっぱいの言い切りを置くので、見出しは追従させない（追従すると言い切りに重なる） */
  .vsn > :global(.sh) {
    grid-row: 1;
    position: static;
  }

  .vs {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: clamp(40px, 4.4vw, 64px);
    padding-bottom: clamp(56px, 7vw, 112px);
    border-bottom: 1px solid var(--rule);
  }

  /* 12 列を subgrid で受け、大きい語は 1 列目、つなぎの語は 8 列目から */
  .vs__in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--g);
    font-feature-settings: "palt";
    font-weight: var(--fw-bold);
  }

  .vs__big {
    font-size: var(--fs-d1);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
    white-space: nowrap;
  }

  .vs__sm {
    font-size: var(--fs-d3);
    line-height: 1.3;
  }

  .vs__a {
    grid-column: 1 / span 7;
    grid-row: 1;
    align-self: last baseline;
  }

  .vs__c1 {
    grid-column: 8 / -1;
    grid-row: 1;
    align-self: last baseline;
  }

  .vs__b {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .vs__c2 {
    grid-column: 8 / -1;
    grid-row: 3;
    margin-top: 0.3em;
  }

  /* 大事にしていること。左の 3 列に小見出し（節の見出しと同じ並び）、4 列目から一覧 */
  .vl__side {
    grid-column: 1 / span 3;
    grid-row: 3;
    align-self: start;
    position: sticky;
    top: calc(var(--hd) + 36px);
    margin-top: clamp(64px, 8vw, 112px);
  }

  .vl__en {
    color: var(--ink-2);
  }

  .vl__head {
    margin-top: 6px;
    font-feature-settings: "palt";
    font-weight: var(--fw-bold);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .vl__body {
    grid-column: 4 / -1;
    grid-row: 3;
    min-width: 0;
    margin-top: clamp(64px, 8vw, 112px);
  }

  @media (max-width: 899px) {
    .vs {
      margin-top: 0;
    }

    .vl__side {
      grid-column: 1 / -1;
      position: static;
    }

    .vl__body {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-top: 20px;
    }
  }

  /* 767px 以下（4 列）: 大きい語は句ごとに改行し、--fs-verb で幅いっぱいに置く。
     つなぎの語は、大きい語の行の続きに置く（「終わり」の右に「ではなく」） */
  @media (max-width: 767px) {
    .vs__in {
      display: block;
    }

    .vs__big {
      font-size: var(--fs-verb);
      line-height: 1.08;
    }

    .vs__big :global(.fx .ph:first-child) {
      display: block;
    }

    .vs__sm {
      font-size: var(--fs-h2);
    }

    .vs__c1 {
      margin-left: 0.4em;
    }

    .vs__c2 {
      display: block;
      margin-top: 0.4em;
    }
  }
</style>
