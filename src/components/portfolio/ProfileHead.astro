---
// メンバーのポートフォリオの冒頭。パンくず、氏名、役割、リード、目次、写真。
// 上下の余白とラベルの位置は、ほかのページの冒頭（PageHero、CaseHead）と同じ値にする。
// 列の位置: 氏名と役割は 1 列目から、リードと目次は 4 列目から（下のセクションの本文と同じ列）、
// 写真は 8 列目から。役割とリードは同じ行に並べる（左の列に見出し、4 列目から本文、という下のセクションと同じ組み方）。
// 写真の比率は、ほかのページと同じ 4:5。
// 氏名は墨の文字で置く。線と塗りの動きは、下から満ちる写真に任せる（一覧のページと同じ）。
// 目次は「つくり方」の目次と同じ書き方（丸、番号、題名。行の高さ 48px）。
// 各セクションの見出しが左の列に追従するので、目次は追従させない。
import Portrait from "@/components/members/Portrait.astro";
import Role from "@/components/members/Role.astro";
import type { Member } from "@/data/members";

interface Chapter {
  id: string;
  /** セクションの番号（SectionHead の番号と同じ） */
  no: string;
  label: string;
}

interface Props {
  member: Member;
  lead: string;
  chapters: Chapter[];
  /** 単体で渡すページ。一覧へ戻るリンクを出さない（ラベルは文字だけにする） */
  bare?: boolean;
}

const { member, lead, chapters, bare = false } = Astro.props;
const columns = Array.from({ length: 12 }, (_, index) => index);
---

<header class="pf">
  <div class="pf__grid" aria-hidden="true">
    {columns.map(index => <i style={`--k:${index}`} />)}
  </div>
  <div class="pf__in">
    <div class="pf__lab mono">
      {
        bare ? (
          <p>Members / メンバー / {member.no}</p>
        ) : (
          <nav aria-label="パンくず">
            <ol class="pf__crumb">
              <li>
                <a href="/members">
                  <span class="dot" aria-hidden="true" />
                  Members / メンバー
                </a>
              </li>
              <li aria-current="page">
                <span aria-hidden="true">/</span>
                <span class="sr">メンバー</span>
                {member.no}
              </li>
            </ol>
          </nav>
        )
      }
    </div>
    <h1 class="pf__name">{member.name}</h1>
    <p class="pf__role"><Role role={member.role} /></p>
    <Portrait
      class="pf__photo"
      photo={member.photo}
      alt={member.name}
      priority
    />
    <p class="pf__lead phrase">{lead}</p>
    <nav class="pf__toc" aria-label="このページの目次">
      <p class="pf__toc-h mono">Contents / 目次</p>
      <ol>
        {
          chapters.map(chapter => (
            <li>
              <a href={`#${chapter.id}`}>
                <span class="dot" aria-hidden="true" />
                <span class="pf__toc-no mono">{chapter.no}</span>
                <span class="pf__toc-t">{chapter.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</header>

<style>
  .pf {
    position: relative;
    padding: clamp(56px, 8vw, 128px) var(--m) clamp(56px, 7vw, 104px);
    overflow: clip;
  }

  .pf__grid {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--m) - var(--g) / 2);
    right: calc(var(--m) - var(--g) / 2);
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    pointer-events: none;
  }

  .pf__grid i {
    border-left: 1px solid var(--rule-2);
    transform-origin: 50% 0;
  }

  .pf__grid i:last-child {
    border-right: 1px solid var(--rule-2);
  }

  :global(html.js:not(.rm)) .pf__grid i {
    transform: scaleY(0);
  }

  :global(html.js.is-go:not(.rm)) .pf__grid i {
    transform: none;
    transition: transform 1.2s var(--ease) calc(var(--k) * 40ms);
  }

  /* 左の 7 列に、ラベル・氏名・役割（1 列目から）と、リード・目次（4 列目から）。
     右の 5 列（8 列目から）に、4:5 の写真。
     3 行目に、役割とリードを横に並べる。4 行目は、写真の高さに合わせて伸びる空き。
     目次と写真は下端をそろえる */
  .pf__in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: auto auto auto minmax(clamp(32px, 3.6vw, 52px), 1fr) auto;
    column-gap: var(--g);
  }

  /* ラベルの行。高さは PageHero のラベルと同じ 1 行ぶん（リンクのはみ出しは打ち消す） */
  .pf__lab {
    grid-column: 1 / span 7;
    grid-row: 1;
    color: var(--ink-2);
  }

  .pf__crumb,
  .pf__crumb li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pf__crumb a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-block: -13px;
    text-decoration: none;
    color: var(--ink);
  }

  .pf__name {
    /* 姓と名の間で折り返さない */
    white-space: nowrap;
    grid-column: 1 / span 7;
    grid-row: 2;
    margin-top: clamp(18px, 2.4vw, 32px);
    font-feature-settings: "palt";
    font-weight: var(--fw-bold);
    font-size: var(--fs-d1);
    line-height: 1.16;
    letter-spacing: var(--ls-display);
  }

  .pf__role {
    grid-column: 1 / span 3;
    grid-row: 3;
    align-self: baseline;
    margin-top: clamp(16px, 1.8vw, 26px);
    font-feature-settings: "palt";
    font-weight: var(--fw-bold);
    font-size: var(--fs-h4);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-label);
    color: var(--ink-2);
  }

  .pf__lead {
    grid-column: 4 / span 4;
    grid-row: 3;
    align-self: baseline;
    margin-top: clamp(16px, 1.8vw, 26px);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }

  .pf__in :global(.pf__photo) {
    grid-column: 8 / -1;
    grid-row: 1 / -1;
    align-self: start;
  }

  /* ───── 目次。墨の罫線、ラベル、罫線で区切った行（「つくり方」の目次と同じ） ───── */
  .pf__toc {
    grid-column: 4 / span 4;
    grid-row: 5;
    border-top: 1px solid var(--ink);
  }

  .pf__toc-h {
    padding: 14px 0 12px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .pf__toc li {
    border-bottom: 1px solid var(--rule);
  }

  /* 押す対象は高さ 44px 以上 */
  .pf__toc a {
    display: grid;
    grid-template-columns: 10px 1.8em minmax(0, 1fr);
    column-gap: 12px;
    align-content: center;
    align-items: baseline;
    min-height: 48px;
    padding: 10px 0;
    text-decoration: none;
    transition: color 0.3s linear;
  }

  .pf__toc a .dot {
    width: 10px;
    height: 10px;
    transform: translateY(1px);
  }

  .pf__toc-no {
    color: var(--ink-2);
  }

  .pf__toc-t {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    letter-spacing: 0.06em;
  }

  /* 押したときの反応。丸に塗りが満ち（共通の .dot）、題名の色が変わる。
     ホバーのない端末でも、押している間は同じ反応を返す */
  .pf__toc a:focus-visible,
  .pf__toc a:active {
    color: var(--teal-deep);
  }

  @media (hover: hover) {
    .pf__toc a:hover {
      color: var(--teal-deep);
    }
  }

  /* 1023px 以下: 左の 7 列に、ラベル・氏名・役割・リードを縦に並べる。右に写真。
     目次は、その下に幅いっぱいの 2 列で置く */
  @media (max-width: 1023px) {
    .pf__in {
      grid-template-rows: auto auto auto auto minmax(0, 1fr) auto;
    }

    .pf__role {
      grid-column: 1 / span 7;
      align-self: start;
      margin-top: clamp(10px, 1.2vw, 18px);
    }

    .pf__lead {
      grid-column: 1 / span 7;
      grid-row: 4;
      align-self: start;
      margin-top: clamp(20px, 3vw, 28px);
      padding-right: var(--g);
    }

    .pf__in :global(.pf__photo) {
      grid-row: 1 / span 5;
    }

    .pf__toc {
      grid-column: 1 / -1;
      grid-row: 6;
      margin-top: 40px;
    }

    .pf__toc ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--g);
    }
  }

  /* 767px 以下（列は 4 つ）: 左の 2 列に、ラベル・氏名・役割・リード。右の 2 列に写真 */
  @media (max-width: 767px) {
    .pf__grid i:nth-child(n + 5) {
      display: none;
    }

    .pf__grid i:nth-child(4) {
      border-right: 1px solid var(--rule-2);
    }

    .pf__lab,
    .pf__name,
    .pf__role,
    .pf__lead {
      grid-column: 1 / span 2;
    }

    .pf__lead {
      padding-right: 0;
    }

    .pf__in :global(.pf__photo) {
      grid-column: 3 / -1;
    }

    .pf__toc {
      margin-top: 32px;
    }
  }

  /* 599px 以下: 上から順に、ラベル・氏名・役割・写真・リード・目次（写真は幅いっぱい。一覧のページと同じ） */
  @media (max-width: 599px) {
    .pf__in {
      grid-template-rows: none;
    }

    .pf__lab,
    .pf__name,
    .pf__role,
    .pf__lead,
    .pf__toc,
    .pf__in :global(.pf__photo) {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .pf__in :global(.pf__photo) {
      margin-top: 22px;
    }

    .pf__lead {
      margin-top: 22px;
    }

    .pf__toc {
      margin-top: 24px;
    }

    .pf__toc ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
