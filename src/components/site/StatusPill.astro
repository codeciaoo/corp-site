---
// 状況のピル。左の輪は、塗りの量で「どこまで動いているか」を示す。
// 塗るのは確かめたものだけ。リリース前の案件は、輪を塗り切らない。
import { statusLevel } from "@/lib/status";

interface Props {
  status: string;
  /** 墨の地の上で使う（紙色のピルにする） */
  invert?: boolean;
}

const { status, invert = false } = Astro.props;
// 状況の文言から、塗りの量を決める。どれにも当たらない文言には、輪を出さない
const level = statusLevel(status);
---

<span class:list={["pill", "mono", { "pill--inv": invert }]}>
  {
    level !== undefined && (
      <i class="pill__lv" style={`--lv:${level}`} aria-hidden="true" />
    )
  }
  {status}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px 5px 9px;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    letter-spacing: 0.06em;
    text-transform: none;
    white-space: nowrap;
  }

  .pill--inv {
    background: var(--paper);
    color: var(--ink);
  }

  .pill__lv {
    position: relative;
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--teal);
    overflow: hidden;
  }

  .pill__lv::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--teal);
    clip-path: inset(calc(100% - var(--lv) * 100%) 0 0 0);
  }
</style>
