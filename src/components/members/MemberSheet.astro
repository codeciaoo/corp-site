---
// メンバー 1 人ぶんの紹介。左の列に写真と、番号・役割・名前（ほかのページの SectionHead と同じ並び）、
// 右に経歴・得意なこと・主な仕事の表。顔と経歴を同じ画面に置く（写真はこの欄にだけ出す）。
// 900px 以上: 左の 3 列が追従する。写真は 3 列の幅（4:5）で、上端を表の罫線にそろえる。番号と名前はその下。
// 768〜899px: 写真は 12 列の 1〜5 列目、番号と名前はその右下。
// 767px 以下: 欄の冒頭に写真を幅いっぱいで置き、その下に番号と名前。
import Portrait from "./Portrait.astro";
import Role from "./Role.astro";
import type { Member } from "@/data/members";

interface Props {
  member: Member;
  tint?: boolean;
}

interface Group {
  /** 「欧文 / 和文」の 1 行で書くラベル */
  label: string;
  items: string[];
  /** 順番に意味がある（経歴） */
  ordered?: boolean;
}

const { member, tint = false } = Astro.props;
const headingId = `h-${member.slug}`;

const groups: Group[] = [
  { label: "Career / 経歴", items: member.career, ordered: true },
  { label: "Strengths / 得意なこと", items: member.skills },
  { label: "Work / 主な仕事", items: member.projects },
].filter(group => group.items.length > 0);
---

<article
  class:list={["sec", "grid", "mb", { "sec--tint": tint }]}
  id={member.slug}
  aria-labelledby={headingId}
>
  <div class="mb__side">
    <Portrait class="mb__photo" photo={member.photo} alt={member.name} />
    <header class="mb__head">
      <span class="mb__no" aria-hidden="true">{member.no}</span>
      <p class="mb__role"><Role role={member.role} /></p>
      <h2 class="mb__name t-h3" id={headingId}>{member.name}</h2>
    </header>
  </div>

  <dl class="mb__rows">
    {
      groups.map(group => (
        <div class="mb__row">
          <dt class="mono">{group.label}</dt>
          <dd>
            {group.ordered ? (
              <ol class="dots">
                {group.items.map(item => (
                  <li>{item}</li>
                ))}
              </ol>
            ) : (
              <ul class="dots">
                {group.items.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</article>

<style>
  /* 左の列。写真の下に、番号・役割・名前（大きさは SectionHead と同じ） */
  .mb__side {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: calc(var(--hd) + 36px);
  }

  .mb__no {
    display: block;
    /* 数字の幅をそろえる。tabular-nums は、子の要素の "palt" に上書きされない */
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-bold);
    font-size: var(--fs-d2);
    /* 数字だけの行。SectionHead の番号と同じ詰め方 */
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  /* 役割は内容なので、等幅の 12px のラベルではなく、14px の本文の字で書く */
  .mb__role {
    margin-top: 22px;
    font-size: var(--fs-small);
    line-height: var(--lh-heading);
    color: var(--ink-2);
  }

  .mb__name {
    margin-top: 4px;
    /* 姓と名の間で折り返さない */
    white-space: nowrap;
  }

  .mb__head {
    margin-top: 28px;
  }

  .mb__rows {
    grid-column: 4 / -1;
    min-width: 0;
    align-self: start;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--ink);
  }

  .mb__row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--rule);
  }

  /* ラベルは 12 列の 4 列目、内容は 8 列目から */
  .mb__row dt {
    grid-column: 1 / span 4;
    color: var(--ink-2);
  }

  .mb__row dd {
    grid-column: 5 / -1;
    min-width: 0;
  }

  /* 899px 以下: 写真は 12 列の 1〜5 列目、番号と名前はその右下。表は幅いっぱい */
  @media (max-width: 899px) {
    .mb__side {
      grid-column: 1 / -1;
      position: static;
      margin-bottom: 40px;
      display: grid;
      grid-template-columns: subgrid;
    }

    .mb :global(.mb__photo) {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    .mb__head {
      grid-column: 6 / -1;
      grid-row: 1;
      align-self: end;
      margin-top: 0;
    }

    /* 名前は、ほかのページの節の見出し（狭い画面では --fs-h2）と同じ大きさ */
    .mb__name {
      font-size: var(--fs-h2);
      line-height: 1.4;
    }

    .mb__rows {
      grid-column: 1 / -1;
    }

    .mb__row dt {
      grid-column: 1 / span 3;
    }

    .mb__row dd {
      grid-column: 4 / -1;
    }
  }

  /* 767px 以下（4 列）: 欄の冒頭に写真を幅いっぱいで置く。その下に、画面の主役の大きさの番号と、
     役割と名前（番号の右下にそろえる）。表のラベルは内容の上 */
  @media (max-width: 767px) {
    .mb__side {
      margin-bottom: 32px;
    }

    .mb :global(.mb__photo) {
      grid-column: 1 / -1;
    }

    .mb__head {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 24px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 16px;
      align-items: end;
    }

    .mb__no {
      grid-row: 1 / span 2;
      font-size: var(--fs-num);
      line-height: 0.82;
      letter-spacing: -0.04em;
    }

    .mb__role {
      margin-top: 0;
    }

    .mb__name {
      margin-top: 2px;
      line-height: 1.2;
    }

    .mb__row {
      padding: 20px 0 22px;
    }

    .mb__row dt,
    .mb__row dd {
      grid-column: 1 / -1;
    }

    .mb__row dd {
      margin-top: 12px;
    }
  }
</style>
