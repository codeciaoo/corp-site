---
// 採用の応募フォーム。項目と送信先は旧フォーム（CareersForm.tsx）と同じ。
// /api/contact へ JSON で type: "careers"、name、email、position、experience、githubUrl、message を送る。
import Field from "@/components/forms/Field.astro";
import Form from "@/components/forms/Form.astro";
import {
  EXPERIENCE_OPTIONS,
  LIMITS,
  POSITION_OPTIONS,
} from "@/components/forms/schema";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<Form
  id={id}
  label="採用の応募フォーム"
  submit="応募する"
  doneTitle="応募を|受け付けました"
  doneBody="内容を確認して、CodeCiaoから連絡します。"
>
  <input type="hidden" name="type" value="careers" />
  <Field
    form={id}
    name="name"
    label="お名前"
    required
    autocomplete="name"
    maxlength={LIMITS.name}
    missing="お名前を入力してください。"
  />
  <Field
    form={id}
    name="email"
    type="email"
    label="メールアドレス"
    required
    autocomplete="email"
    maxlength={LIMITS.email}
    missing="メールアドレスを入力してください。"
    invalid="メールアドレスの形式を確かめてください。入力例はname@example.comです。"
  />
  <Field
    form={id}
    name="position"
    type="select"
    label="希望職種"
    required
    prefill
    options={POSITION_OPTIONS}
    missing="希望職種を選んでください。"
  />
  <Field
    form={id}
    name="experience"
    type="select"
    label="経験年数"
    required
    options={EXPERIENCE_OPTIONS}
    missing="経験年数を選んでください。"
  />
  <Field
    form={id}
    name="githubUrl"
    type="url"
    label="GitHubのURL"
    autocomplete="url"
    maxlength={LIMITS.url}
    invalid="URLの形式を確かめてください。入力例はhttps://github.com/yournameです。"
  />
  <Field
    form={id}
    name="message"
    type="textarea"
    label="自己PR"
    hint="スキル、経験、志望の理由を書いてください。"
    maxlength={LIMITS.message}
  />

  <Fragment slot="note">
    送信すると、<a class="inline" href="/privacy-policy">個人情報保護方針</a
    >に同意したものとして扱います。
  </Fragment>

  <p class="next" slot="done">
    <a class="btn" href="/approach">つくり方を読む</a>
    <a class="link" href="/">
      <span class="dot" aria-hidden="true"></span>
      トップへ
    </a>
  </p>
</Form>

<style>
  .next {
    margin-top: 32px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
</style>
