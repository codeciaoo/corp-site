---
// 実績の詳細の目次。墨の線、ラベル、罫線で区切った行（つくり方のページの目次と同じ組み方）。
// rail: 900px 以上で、本文の左の 1〜3 列目に追従する（CaseBody の 12 列の直接の子として置く）。
// top:  899px 以下で、冒頭の表（CaseHead）の直後に置く。長いページでも、冒頭から章へ移れるように。
// どの幅でも、見えている目次は 1 つだけ（もう片方は display: none）。
// 目次の点は、読んだ章まで塗る（CaseBody のスクリプトが、両方の目次の [data-toc] a を動かす）。
import type { Chapter } from "./chapters";

interface Props {
  chapters: Chapter[];
  variant: "rail" | "top";
}

const { chapters, variant } = Astro.props;
const pad = (value: number): string => String(value).padStart(2, "0");
---

<nav
  class:list={["toc", `toc--${variant}`]}
  aria-label="このページの目次"
  data-toc
>
  <p class="toc__h mono">Contents / 目次</p>
  <ol>
    {
      chapters.map((chapter, index) => (
        <li>
          <a href={`#${chapter.slug}`}>
            <i class="mk" aria-hidden="true" />
            <span class="toc__no mono" aria-hidden="true">
              {pad(index + 1)}
            </span>
            <span>{chapter.text}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .toc {
    border-top: 1px solid var(--ink);
  }

  .toc--rail {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: calc(var(--hd) + 36px);
  }

  .toc--top {
    display: none;
  }

  @media (max-width: 899px) {
    .toc--rail {
      display: none;
    }

    .toc--top {
      display: block;
      margin: 0 var(--m) 56px;
    }
  }

  .toc__h {
    padding: 14px 0 12px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
    text-transform: none;
  }

  .toc li {
    border-bottom: 1px solid var(--rule);
  }

  .toc a {
    display: grid;
    grid-template-columns: 10px 1.8em minmax(0, 1fr);
    column-gap: 12px;
    align-content: center;
    align-items: baseline;
    min-height: 48px;
    padding: 10px 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 0.3s linear;
  }

  .toc__no {
    color: var(--ink-2);
  }

  /* いま読んでいる章は字の色で示す。点は縦に 1 列のまま動かさない */
  .toc a:focus-visible,
  .toc a:active,
  .toc a[aria-current] {
    color: var(--teal-deep);
  }

  @media (hover: hover) {
    .toc a:hover {
      color: var(--teal-deep);
    }
  }

  /* 目次の点。線はまだ読んでいない章、塗りは読んだ章（いま読んでいる章まで、下から塗りが満ちる） */
  .mk {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--teal);
    overflow: hidden;
    transform: translateY(1px);
  }

  .mk::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--teal);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    transition: clip-path 0.45s var(--ease);
  }

  .toc a.is-read .mk::after,
  .toc a:active .mk::after {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }
</style>
