---
import Arrow from "@/components/site/Arrow.astro";
import SectionHead from "@/components/site/SectionHead.astro";
import { ENGAGEMENTS } from "@/data/home";
---

<section class="sec grid" aria-labelledby="h-engage">
  <SectionHead no="05" en="Engagement" title="契約と開始" id="h-engage" big />
  <div class="body">
    <p class="eg__head phrase">契約の形は2つ</p>
    <div class="eg">
      {
        ENGAGEMENTS.map(item => (
          <article class="eg__card">
            <p class="eg__mark" aria-hidden="true">
              {item.mark}
            </p>
            <h3 class="eg__ttl">{item.title}</h3>
            <p class="eg__contract mono">{item.contract}</p>
            <p class="eg__body">{item.body}</p>
            <ul class="eg__points">
              {item.points.map(point => (
                <li>
                  <span class="dot is-on" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="eg__next">
      <p class="eg__note phrase">
        相談から開始までは4つの段階で進みます。急ぐ場合は、相談から1週間で開始できます。
      </p>
      <a class="btn btn--lg" href="/contact">
        相談から開始までの流れを見る
        <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .body {
    grid-column: 4 / -1;
    min-width: 0;
  }

  .eg__head {
    font-feature-settings: "palt";
    font-weight: var(--fw-bold);
    font-size: var(--fs-d3);
    line-height: 1.4;
    letter-spacing: var(--ls-display);
  }

  .eg {
    margin-top: clamp(36px, 4.6vw, 60px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }

  .eg__card {
    padding: 28px var(--g) 32px 0;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .eg__card + .eg__card {
    padding-left: var(--g);
    padding-right: 0;
    border-right: 0;
  }

  /* A と B は同じ扱い（どちらも塗り）。線と塗りは「設計と確かめた事実」の意味でだけ使う */
  .eg__mark {
    font-weight: var(--fw-bold);
    font-size: var(--fs-d3);
    line-height: 1;
    color: var(--teal);
  }

  .eg__ttl {
    margin-top: 20px;
    font-feature-settings: "palt";
    font-weight: var(--fw-bold);
    font-size: var(--fs-h2);
    line-height: 1.4;
    letter-spacing: var(--ls-heading);
  }

  .eg__contract {
    margin-top: 4px;
    color: var(--ink-2);
    text-transform: none;
  }

  .eg__body {
    margin-top: 16px;
    font-size: var(--fs-body);
    line-height: 1.9;
  }

  .eg__points {
    margin-top: 18px;
    display: grid;
    gap: 8px;
    font-size: var(--fs-small);
    line-height: 1.8;
  }

  .eg__points li {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr);
    column-gap: 12px;
    align-items: baseline;
  }

  .eg__points .dot {
    transform: translateY(-1px);
  }

  .eg__next {
    margin-top: clamp(36px, 4.6vw, 60px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }

  .eg__note {
    max-width: 30em;
    font-size: var(--fs-body);
    line-height: 1.9;
  }

  @media (max-width: 899px) {
    .body {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .eg {
      grid-template-columns: 1fr;
    }

    .eg__card,
    .eg__card + .eg__card {
      padding: 26px 0 28px;
      border-right: 0;
    }
  }
</style>
